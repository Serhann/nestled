# ─────────────────────────────────────────────────────────────────────────────
# Nestled — STAGING environment (for docker-compose.staging.yml)
#
# In Coolify: paste these under the resource's "Environment Variables" (Coolify
# reads them for compose ${VAR} substitution).
#
# EVERY secret below is a PLACEHOLDER. Generate real values per environment and
# never commit them:
#   openssl rand -base64 48            # JWT secrets, POSTGRES_PASSWORD
#   cd server && npm run vapid         # VAPID keypair
# ─────────────────────────────────────────────────────────────────────────────

# ── Public URLs ───────────────────────────────────────────────────────────────
# The domain Coolify binds to the `web` service (port 80).
SERVICE_FQDN_WEB=https://staging.nestled.chat

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=nestled
POSTGRES_DB=nestled_staging
POSTGRES_PASSWORD=generate-me-openssl-rand-base64-48

# ── Auth secrets (JWT) ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=generate-me-openssl-rand-base64-48
JWT_REFRESH_SECRET=generate-me-openssl-rand-base64-48

# ── CORS: the PRIVATE app surface only ────────────────────────────────────────
# Customer domains do NOT belong here. Where the widget may run is enforced
# per-website by the `websites.allowed_domains` allowlist in the database.
# The WIDGET origin must be here too. It serves the widget document and calls
# the API from there, so omitting it makes every widget request fail in the
# browser with a CORS error that looks like the API is down.
ALLOWED_ORIGINS=https://app.staging.nestled.chat,https://ops.staging.nestled.chat,https://widget.staging.nestled.chat,https://staging.nestled.chat

# Used to build links in outbound email. Wrong values send people to the wrong
# host, and they will not tell you — they will just fail to confirm.
APP_URL=https://app.staging.nestled.chat
MARKETING_URL=https://staging.nestled.chat

# ── AI provider (platform-owned; usage is metered per workspace) ──────────────
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=

# ── Web Push (VAPID) — generate with `cd server && npm run vapid` ─────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@nestled.chat

# ── Uploads / limits ──────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760

# ── IP geolocation ────────────────────────────────────────────────────────────
# Option A: local GeoLite2 DB (offline). Place at ./server/geoip/GeoLite2-City.mmdb.
GEOLITE2_DB_PATH=
# Option B (preferred here): MaxMind GeoIP web service — per-IP REST lookup.
# When account id + key are set, this is used instead of the local DB.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# GeoIP2 Precision City (default here). For the free GeoLite2 service use:
#   https://geolite.info/geoip/v2.1/city
MAXMIND_ENDPOINT=https://geoip.maxmind.com/geoip/v2.1/city

# ── Transactional email (SMTP) ────────────────────────────────────────────────
# Leave SMTP_HOST blank and mail is queued to `outbound_emails` and logged
# instead of sent — nothing is lost, but signup verification and invitations
# then require reading the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Nestled <noreply@nestled.chat>

# ── Billing (Stripe) ──────────────────────────────────────────────────────────
# Unset, plans and limits still apply — they are database facts. Only checkout
# and the billing portal are disabled, which is a perfectly good self-hosted
# configuration. Use TEST keys in staging; never live ones.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_URL=

# ── Optional integrations ─────────────────────────────────────────────────────
SENTRY_DSN=
DISCORD_WEBHOOK_URL=

# Conversation retention sweep (days). 0 = keep forever.
RETENTION_DAYS=30

# ── First-admin bootstrap (runs once on boot; no-op if a user exists) ─────────
# This creates a CUSTOMER account and its workspace. Everyone else signs up.
SEED_ADMIN_EMAIL=admin@nestled.chat
SEED_ADMIN_PASSWORD=change-me-on-first-login
SEED_ADMIN_NAME=Admin

# ── First STAFF account, for the ops panel ────────────────────────────────────
# A different plane entirely: opaque sessions checked against the database, not
# the customer JWT. The seeded account can READ everything and CHANGE nothing
# until a TOTP factor is enrolled — an identity provisioned from an env var
# should not be able to touch customer data on its own.
SEED_PLATFORM_EMAIL=ops@nestled.chat
SEED_PLATFORM_PASSWORD=change-me-on-first-login
PLATFORM_SESSION_TTL_HOURS=12
