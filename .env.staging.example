# ─────────────────────────────────────────────────────────────────────────────
# JetChat — STAGING environment (for docker-compose.staging.yml)
#
# In Coolify: paste these under the resource's "Environment Variables" (Coolify
# reads them for compose ${VAR} substitution). Secrets below are freshly
# generated for staging — regenerate for production and never commit real
# values to git (this file is an EXAMPLE; keep the real one out of the repo).
# ─────────────────────────────────────────────────────────────────────────────

# ── Public URL ────────────────────────────────────────────────────────────────
# The domain Coolify binds to the `web` service (port 80). Also used to build
# ALLOWED_ORIGINS below.
SERVICE_FQDN_WEB=https://staging.jetchat.example.com

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=jetchat
POSTGRES_DB=jetchat_staging
POSTGRES_PASSWORD=c82c4f950d2fe6e154c4f1327be3b6e33ab1afa4648e4885

# ── Auth secrets (JWT) ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=tMrdBbxY8MLkJHzPptgh35VmrP8/YGVgc6MBqvrwQOXGNfMn6dNEz1uq+6jCB5WH
JWT_REFRESH_SECRET=eeyA6Ya+tiRemHYvhkeiAPtnVKg0TYWBLd0Ibm/6YoHsdYQmLDCzUnW2jrgWakqZ

# ── CORS: sites allowed to call the API / open sockets (the widget's hosts) ────
# Include the widget's own origin plus every customer domain it's embedded on.
ALLOWED_ORIGINS=https://staging.jetchat.example.com,https://staging.jetfood.com,https://staging.tryjet.io

# ── AI provider ───────────────────────────────────────────────────────────────
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=

# ── Web Push (VAPID) — generated keypair, safe for staging ────────────────────
VAPID_PUBLIC_KEY=BEMp_ndiELXysB1EQwHYAEP-5nQA2OueR1iUB-ywUFslhJlN-wTsjCP3QsrsroqF-r07G7CVrOHK8oLFVr66lvE
VAPID_PRIVATE_KEY=UFIfUGTwdjy2UjvClu6rhb8EzQCvkWyOcc0r0wFnp18
VAPID_SUBJECT=mailto:admin@jetfood.com

# ── Uploads / limits ──────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760

# ── Optional integrations ─────────────────────────────────────────────────────
# ── IP geolocation ────────────────────────────────────────────────────────────
# Option A: local GeoLite2 DB (offline). Place at ./server/geoip/GeoLite2-City.mmdb.
GEOLITE2_DB_PATH=
# Option B (preferred here): MaxMind GeoIP web service — per-IP REST lookup.
# When account id + key are set, this is used instead of the local DB.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
# GeoIP2 Precision City (default here). For the free GeoLite2 service use:
#   https://geolite.info/geoip/v2.1/city
MAXMIND_ENDPOINT=https://geoip.maxmind.com/geoip/v2.1/city
SENTRY_DSN=
DISCORD_WEBHOOK_URL=

# Conversation retention sweep (days). 0 = keep forever.
RETENTION_DAYS=30

# ── First-admin bootstrap (runs once on boot; no-op if an agent exists) ───────
SEED_ADMIN_EMAIL=admin@jetfood.com
SEED_ADMIN_PASSWORD=change-me-on-first-login
SEED_ADMIN_NAME=Admin
