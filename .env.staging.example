# ─────────────────────────────────────────────────────────────────────────────
# Nestled — environment
#
# Short on purpose. Everything here is either a secret the process needs before
# it can read a database, or a fact about WHERE this container runs.
#
# Everything else — the AI key, SMTP, Stripe, GeoIP, VAPID, the public URLs,
# retention — is configured in the OPS PANEL at https://ops.<your-host>/settings
# and stored in the database. Those are settings: you change them on a Tuesday
# afternoon, and putting them here means a container restart to do it.
#
# (Those variables do still work as a fallback if you prefer config-as-code.
# They are simply not required, and are no longer listed in the compose files.)
#
# EVERY secret below is a PLACEHOLDER:
#   openssl rand -base64 48       # JWT secrets, POSTGRES_PASSWORD, SETTINGS_KEY
# ─────────────────────────────────────────────────────────────────────────────

# ── The domain Coolify binds to the `web` service (port 80) ───────────────────
SERVICE_FQDN_WEB=https://staging.nestled.chat

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=nestled
POSTGRES_DB=nestled_staging
POSTGRES_PASSWORD=generate-me-openssl-rand-base64-48

# ── Auth secrets ──────────────────────────────────────────────────────────────
# These cannot move into the database: they are what proves a request is allowed
# to reach the database in the first place. Rotating JWT_ACCESS_SECRET signs out
# every agent AND invalidates every live widget session.
JWT_ACCESS_SECRET=generate-me-openssl-rand-base64-48
JWT_REFRESH_SECRET=generate-me-openssl-rand-base64-48

# ── Encryption for the settings stored in the database ────────────────────────
# Optional, and worth setting. Without it the API keys you enter in the ops panel
# sit in the database in plain text — and while it already holds conversation
# history, a leaked backup containing a live Stripe key is a different category
# of problem, because that key moves money.
#
# Changing this makes existing stored secrets unreadable; they are reported as
# absent (loudly, in the log) and can be re-entered.
SETTINGS_KEY=generate-me-openssl-rand-base64-48

# ── CORS: the PRIVATE surfaces only ───────────────────────────────────────────
# Deployment topology, not a setting — it describes where THIS install is served
# from and is handed to the CORS plugin at boot.
#
# The WIDGET origin must be included. It serves the widget document and calls the
# API from there, so omitting it makes every widget request fail in the browser
# with a CORS error that looks like the API is down.
#
# Customer domains do NOT belong here. Where a widget may run is enforced
# per-website by the `websites.allowed_domains` allowlist in the database.
ALLOWED_ORIGINS=https://app.staging.nestled.chat,https://ops.staging.nestled.chat,https://widget.staging.nestled.chat,https://staging.nestled.chat

# ── Uploads ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760

# ── One-time bootstrap ────────────────────────────────────────────────────────
# A CUSTOMER account and its workspace. Everyone else signs up or is invited.
SEED_ADMIN_EMAIL=admin@nestled.chat
SEED_ADMIN_PASSWORD=change-me-on-first-login
SEED_ADMIN_NAME=Admin

# The first STAFF account, for the ops panel — a different plane entirely: opaque
# sessions checked against the database, not the customer JWT. It can READ
# everything and CHANGE nothing until a TOTP factor is enrolled, because an
# identity provisioned from an env var should not be able to touch customer data
# on its own.
SEED_PLATFORM_EMAIL=ops@nestled.chat
SEED_PLATFORM_PASSWORD=change-me-on-first-login
