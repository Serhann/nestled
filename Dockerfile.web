# ── Frontend (Vite MPA) served by nginx, which also proxies /api + /ws to the
# backend `app` service. One public container per environment.
#
#   Build stage: compile the static site (index/app/ops/widget).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
# Optional: bake a fixed API base at build time. Leave unset for same-origin
# (the app is reached through this nginx via /api + /ws).
ARG VITE_API_BASE=""
ENV VITE_API_BASE=$VITE_API_BASE
RUN npm run build

# ── Runtime: nginx serving dist/ + reverse-proxying the API/WS ────────────────
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
