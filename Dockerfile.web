# ── Frontend (Vite MPA) served by nginx, which also proxies /api + /ws to the
# backend `app` service. One public container per environment.
#
#   Build stage: compile the static site (index/app/ops/widget).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
# Optional: bake a fixed API base at build time. Leave unset for same-origin
# (the app is reached through this nginx via /api + /ws).
ARG VITE_API_BASE=""
ENV VITE_API_BASE=$VITE_API_BASE
RUN npm run build

# ── Runtime: nginx serving dist/ + reverse-proxying the API/WS ────────────────
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# Sitemap, robots' Sitemap line, and og:url — the SEO artifacts that need an absolute URL,
# which the build cannot know because origins are resolved from the address bar at runtime.
#
# `/docker-entrypoint.d/*.sh` is run by the nginx image's own entrypoint before nginx starts,
# in filename order. The 40- prefix puts this after the image's own 10-/20-/30- scripts, so
# the envsubst templating those provide has already happened. Nothing here can keep nginx from
# starting: the script writes files and exits, and given no domain it exits 0 having stripped
# the placeholders. See scripts/seo-runtime.sh for why silence beats a guessed domain.
COPY scripts/seo-runtime.sh /docker-entrypoint.d/40-seo.sh
RUN chmod +x /docker-entrypoint.d/40-seo.sh

# The Google tag, for the environments that want one. Same reasoning as above — the image is
# shared between staging and production, so the measurement ID arrives as GA_MEASUREMENT_ID at
# start rather than baked into the build, and an environment that does not set it ships
# untagged pages. 45- rather than 40-: it runs after the SEO script, which rewrites the same
# documents, so the two never race over one file. See scripts/analytics-runtime.sh.
COPY scripts/analytics-runtime.sh /docker-entrypoint.d/45-analytics.sh
RUN chmod +x /docker-entrypoint.d/45-analytics.sh

EXPOSE 80
