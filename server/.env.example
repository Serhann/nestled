# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Postgres connection string (used by Prisma). For local dev against the
# Docker Compose Postgres, use the published host port (default 5544). Inside
# Compose the app talks to the `db` service on 5432 (set in docker-compose.yml).
DATABASE_URL=postgres://jetchat:jetchat@localhost:5544/jetchat

# ── Auth secrets (REQUIRED — generate long random values in production) ───────
# e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowlist of browser origins. NO wildcard.
ALLOWED_ORIGINS=https://www.jetfood.com,https://jetfood.com,http://localhost:5173

# Open agent registration is allowed only while zero agents exist (bootstrap the
# first admin). After that, create agents via the admin API.
ALLOW_OPEN_REGISTRATION=true

# ── AI (server-side only — NEVER ship these to the client) ────────────────────
# Default provider is Anthropic Claude. Model is configurable; claude-haiku-4-5
# is the cheaper/faster option.
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
# Optional alternate providers:
OPENAI_API_KEY=
OLLAMA_URL=

# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Generate once with `npm run vapid` and paste both lines here. If left blank,
# push is disabled gracefully (the admin can't subscribe; nothing else breaks).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI required by the push spec (mailto: or https:).
VAPID_SUBJECT=mailto:admin@jetfood.com

# ── Geo-IP ────────────────────────────────────────────────────────────────────
# Option A: local MaxMind GeoLite2 DB (offline). Path to a City/Country .mmdb.
GEOLITE2_DB_PATH=
# Option B: MaxMind GeoIP web service (per-IP REST lookup). When the account id
# and license key are set, geo is fetched from MaxMind instead of the local DB.
# Endpoint defaults to the free GeoLite2 city service; for GeoIP2 Precision set
# MAXMIND_ENDPOINT=https://geoip.maxmind.com/geoip/v2.1/city
# When none of these are set, geo is disabled gracefully (no external call).
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_ENDPOINT=https://geolite.info/geoip/v2.1/city

# ── Attachments ───────────────────────────────────────────────────────────────
# Directory for uploaded files (created on demand). In Docker use a mounted
# volume path so uploads survive restarts. Per-file cap in bytes.
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# ── Ops ───────────────────────────────────────────────────────────────────────
# Optional Sentry-compatible error DSN (forwarding hook in the error handler).
SENTRY_DSN=
# Delete resolved conversations (+ their attachments) older than N days. 0 = off.
RETENTION_DAYS=0

# ── Optional secondary notification channel ───────────────────────────────────
DISCORD_WEBHOOK_URL=

# ── Seed (used by `npm run seed`) ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
